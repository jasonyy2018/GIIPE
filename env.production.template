# ============================================
# GIIP Conference Platform - Production Environment Variables
# ============================================
# 重要提示：请在生产环境中修改所有密码和密钥！
# 使用强密码保护您的系统安全。
# ============================================

# ============================================
# 数据库配置 (PostgreSQL)
# ============================================
POSTGRES_DB=conference_platform
POSTGRES_USER=conference_user
# ⚠️ 请修改为强密码！建议使用至少 16 个字符，包含大小写字母、数字和特殊字符
POSTGRES_PASSWORD=ChangeMeToSecurePassword123!

# ============================================
# Redis 缓存配置
# ============================================
# ⚠️ 请修改为强密码！
REDIS_PASSWORD=ChangeMeToRedisPassword456!

# ============================================
# JWT 认证密钥
# ============================================
# ⚠️ 这些密钥用于生成和验证 JWT Token，请务必保密！
# 已生成随机密钥，请妥善保管，不要泄露！
JWT_SECRET=TbZ+uSxDYxE6xXLNFDoo7GNqvpqJZ1EdLcCmHYIykOY=
JWT_REFRESH_SECRET=EuvyIA9Y8yzGNODhmeUavTzakssv59QEM+2IdR7waPg=

# ============================================
# CSRF 保护密钥
# ============================================
# ⚠️ 用于 CSRF 保护，请务必保密！
CSRF_SECRET=mV8W+B3bAAAIa3DFGB20KT5nyVNgN4Ras7f4tej/zMA=

# ============================================
# 邮件配置 (可选)
# ============================================
# 如果不需要邮件功能，可以留空或使用占位符
# Gmail 示例配置：
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password
# EMAIL_FROM=noreply@yourdomain.com

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# ============================================
# AWS S3 存储配置 (可选)
# ============================================
# 如果使用本地存储，这些可以留空
# 如果使用 S3，请填写以下信息并设置 STORAGE_TYPE=s3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ============================================
# 存储类型配置
# ============================================
# 选项: 'local' 或 's3'
# 使用本地存储时设置为 'local'
# 使用 AWS S3 时设置为 's3'
STORAGE_TYPE=local

# ============================================
# 前端配置
# ============================================
# ⚠️ 请根据您的实际域名修改这些 URL
# 如果使用 HTTPS，请确保使用 https:// 协议

# API 地址（用户访问的前端 API 地址）
# 示例: https://giip.info/api 或 http://your-server-ip/api
NEXT_PUBLIC_API_URL=https://giip.info/api

# 网站名称
NEXT_PUBLIC_SITE_NAME=GIIP Conference Platform

# 网站 URL（用于生成链接）
# 示例: https://giip.info 或 http://your-server-ip
NEXT_PUBLIC_SITE_URL=https://giip.info

# NextAuth 配置
# ⚠️ NextAuth URL（通常与 NEXT_PUBLIC_SITE_URL 相同）
# 示例: https://giip.info 或 http://your-server-ip
NEXTAUTH_URL=https://giip.info

# ⚠️ NextAuth Secret（用于加密会话和令牌）
# 生成方法: openssl rand -base64 32
# 请务必使用强随机字符串！
NEXTAUTH_SECRET=

# ============================================
# 应用配置
# ============================================
# 上传文件最大大小（字节），默认 10MB
UPLOAD_MAX_SIZE=10485760

# 速率限制配置
# RATE_LIMIT_WINDOW: 时间窗口（毫秒），默认 15 分钟
RATE_LIMIT_WINDOW=900000
# RATE_LIMIT_MAX: 每个时间窗口内的最大请求数
RATE_LIMIT_MAX=100

# 日志级别: 'error', 'warn', 'info', 'debug'
LOG_LEVEL=info

# ============================================
# 安全提示
# ============================================
# 1. 请立即修改所有密码和密钥
# 2. 确保 .env.production 文件权限设置为 600: chmod 600 .env.production
# 3. 不要将 .env.production 文件提交到版本控制系统
# 4. 定期更换密码和密钥
# 5. 使用 HTTPS 保护数据传输


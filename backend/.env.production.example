# Production Environment Configuration for Admin Interface Enhancements

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/conference_management_prod"

# JWT Configuration
JWT_SECRET="your-super-secure-jwt-secret-for-production"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_SECRET="your-super-secure-refresh-secret-for-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis Configuration (for caching and sessions)
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""
REDIS_DB=0

# Email Configuration
SMTP_HOST="smtp.your-email-provider.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@domain.com"
SMTP_PASS="your-email-password"
FROM_EMAIL="noreply@giip.info"
FROM_NAME="Global Innovation and Intellectual Property (GIIP)"

# File Storage Configuration
STORAGE_TYPE="s3" # or "local"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_S3_BUCKET="your-s3-bucket-name"
LOCAL_STORAGE_PATH="./uploads"

# Frontend URL
FRONTEND_URL="https://giip.info"

# API Configuration
API_PORT=3001
API_HOST="0.0.0.0"
API_PREFIX="api"

# Security Configuration
CORS_ORIGIN="https://giip.info"
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
BCRYPT_ROUNDS=12

# Admin Interface Configuration
ADMIN_DEFAULT_EMAIL="admin@giip.info"
ADMIN_DEFAULT_PASSWORD="change-this-password"
ADMIN_SESSION_TIMEOUT=3600000 # 1 hour in milliseconds
ADMIN_MAX_CONCURRENT_SESSIONS=3

# WebSocket Configuration
WEBSOCKET_CORS_ORIGIN="https://giip.info"
WEBSOCKET_HEARTBEAT_INTERVAL=30000 # 30 seconds
WEBSOCKET_CONNECTION_TIMEOUT=60000 # 60 seconds

# Monitoring and Logging
LOG_LEVEL="info" # error, warn, info, debug
LOG_FORMAT="json" # json or simple
ENABLE_REQUEST_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true

# Cache Configuration
CACHE_TTL_DEFAULT=300 # 5 minutes
CACHE_TTL_DASHBOARD_METRICS=60 # 1 minute
CACHE_TTL_USER_LIST=180 # 3 minutes
CACHE_TTL_ANALYTICS=600 # 10 minutes

# Security Monitoring
SECURITY_ALERT_EMAIL="security@giip.info"
FAILED_LOGIN_THRESHOLD=5
FAILED_LOGIN_WINDOW_MS=300000 # 5 minutes
IP_BLOCK_DURATION_MS=3600000 # 1 hour
ENABLE_IP_BLOCKING=true

# Performance Configuration
DATABASE_POOL_SIZE=20
DATABASE_CONNECTION_TIMEOUT=30000
API_TIMEOUT=30000
BULK_OPERATION_BATCH_SIZE=100
MAX_CONCURRENT_BULK_OPERATIONS=3

# Feature Flags
ENABLE_REAL_TIME_UPDATES=true
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_BULK_OPERATIONS=true
ENABLE_AUDIT_LOGGING=true
ENABLE_SECURITY_MONITORING=true
ENABLE_PERFORMANCE_OPTIMIZATION=true

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *" # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET="your-backup-bucket"

# Notification Configuration
NOTIFICATION_QUEUE_ENABLED=true
NOTIFICATION_RETRY_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY=5000 # 5 seconds
EMAIL_TEMPLATE_CACHE_TTL=3600 # 1 hour

# Analytics Configuration
ANALYTICS_RETENTION_DAYS=365
ANALYTICS_AGGREGATION_INTERVAL="1 hour"
ENABLE_REAL_TIME_ANALYTICS=true

# Content Moderation
SENSITIVE_WORD_CACHE_TTL=1800 # 30 minutes
MODERATION_QUEUE_BATCH_SIZE=50
AUTO_MODERATION_ENABLED=false
MODERATION_CONFIDENCE_THRESHOLD=0.8

# System Health Monitoring
HEALTH_CHECK_INTERVAL=30000 # 30 seconds
HEALTH_CHECK_TIMEOUT=5000 # 5 seconds
ENABLE_HEALTH_ALERTS=true
HEALTH_ALERT_EMAIL="ops@giip.info"

# Deployment Configuration
NODE_ENV="production"
PM2_INSTANCES=4 # Number of PM2 instances
PM2_MAX_MEMORY_RESTART="1G"
PM2_ERROR_FILE="./logs/pm2-error.log"
PM2_OUT_FILE="./logs/pm2-out.log"
PM2_LOG_FILE="./logs/pm2.log"
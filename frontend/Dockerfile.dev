FROM node:22-alpine

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy package files
COPY package.json pnpm-lock.yaml* ./

# Install dependencies using pnpm
RUN pnpm install --frozen-lockfile || pnpm install

# Copy source code
COPY . .

EXPOSE 3000

# Start development server
CMD ["pnpm", "run", "dev"]

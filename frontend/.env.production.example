# Production Environment Configuration for Frontend Admin Interface

# API Configuration
NEXT_PUBLIC_API_URL="https://api.giip.info"
NEXT_PUBLIC_WEBSOCKET_URL="wss://api.giip.info"

# Application Configuration
NEXT_PUBLIC_APP_NAME="Global Innovation and Intellectual Property (GIIP)"
NEXT_PUBLIC_APP_VERSION="2.0.0"
NEXT_PUBLIC_ENVIRONMENT="production"

# Authentication Configuration
NEXTAUTH_URL="https://giip.info"
NEXTAUTH_SECRET="your-nextauth-secret-for-production"
JWT_SECRET="your-jwt-secret-matching-backend"

# Admin Interface Configuration
NEXT_PUBLIC_ADMIN_DASHBOARD_REFRESH_INTERVAL=30000 # 30 seconds
NEXT_PUBLIC_ADMIN_SESSION_TIMEOUT=3600000 # 1 hour
NEXT_PUBLIC_ENABLE_REAL_TIME_UPDATES=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# WebSocket Configuration
NEXT_PUBLIC_WEBSOCKET_RECONNECT_INTERVAL=5000 # 5 seconds
NEXT_PUBLIC_WEBSOCKET_MAX_RECONNECT_ATTEMPTS=10
NEXT_PUBLIC_WEBSOCKET_HEARTBEAT_INTERVAL=30000 # 30 seconds

# UI Configuration
NEXT_PUBLIC_THEME="light" # light, dark, auto
NEXT_PUBLIC_DEFAULT_LANGUAGE="en"
NEXT_PUBLIC_TIMEZONE="UTC"
NEXT_PUBLIC_DATE_FORMAT="YYYY-MM-DD"
NEXT_PUBLIC_TIME_FORMAT="HH:mm:ss"

# Performance Configuration
NEXT_PUBLIC_ENABLE_SERVICE_WORKER=true
NEXT_PUBLIC_CACHE_STRATEGY="stale-while-revalidate"
NEXT_PUBLIC_IMAGE_OPTIMIZATION=true
NEXT_PUBLIC_LAZY_LOADING=true

# Analytics Configuration
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ANALYTICS_REFRESH_INTERVAL=60000 # 1 minute
NEXT_PUBLIC_CHART_ANIMATION_DURATION=750
NEXT_PUBLIC_MAX_CHART_DATA_POINTS=100

# Table Configuration
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=25
NEXT_PUBLIC_MAX_PAGE_SIZE=100
NEXT_PUBLIC_ENABLE_VIRTUAL_SCROLLING=true
NEXT_PUBLIC_TABLE_CACHE_SIZE=1000

# File Upload Configuration
NEXT_PUBLIC_MAX_FILE_SIZE=10485760 # 10MB
NEXT_PUBLIC_ALLOWED_FILE_TYPES="image/*,application/pdf,.doc,.docx,.xls,.xlsx"
NEXT_PUBLIC_UPLOAD_CHUNK_SIZE=1048576 # 1MB

# Security Configuration
NEXT_PUBLIC_ENABLE_CSP=true
NEXT_PUBLIC_ENABLE_CSRF_PROTECTION=true
NEXT_PUBLIC_SESSION_STORAGE_KEY="admin_session"
NEXT_PUBLIC_SECURE_COOKIES=true

# Monitoring Configuration
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=true
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true
NEXT_PUBLIC_LOG_LEVEL="warn" # error, warn, info, debug

# Feature Flags
NEXT_PUBLIC_ENABLE_BULK_OPERATIONS=true
NEXT_PUBLIC_ENABLE_ADVANCED_FILTERS=true
NEXT_PUBLIC_ENABLE_EXPORT_FUNCTIONS=true
NEXT_PUBLIC_ENABLE_DRAG_AND_DROP=true
NEXT_PUBLIC_ENABLE_KEYBOARD_SHORTCUTS=true

# Notification Configuration
NEXT_PUBLIC_NOTIFICATION_POSITION="top-right"
NEXT_PUBLIC_NOTIFICATION_DURATION=5000 # 5 seconds
NEXT_PUBLIC_MAX_NOTIFICATIONS=5
NEXT_PUBLIC_ENABLE_SOUND_NOTIFICATIONS=false

# Dashboard Configuration
NEXT_PUBLIC_DASHBOARD_AUTO_REFRESH=true
NEXT_PUBLIC_DASHBOARD_REFRESH_INTERVAL=30000 # 30 seconds
NEXT_PUBLIC_DASHBOARD_WIDGET_CACHE_TTL=60000 # 1 minute
NEXT_PUBLIC_MAX_DASHBOARD_WIDGETS=12

# Search Configuration
NEXT_PUBLIC_SEARCH_DEBOUNCE_DELAY=300 # 300ms
NEXT_PUBLIC_MIN_SEARCH_LENGTH=2
NEXT_PUBLIC_MAX_SEARCH_RESULTS=50
NEXT_PUBLIC_ENABLE_SEARCH_HIGHLIGHTING=true

# Accessibility Configuration
NEXT_PUBLIC_ENABLE_HIGH_CONTRAST=false
NEXT_PUBLIC_ENABLE_REDUCED_MOTION=false
NEXT_PUBLIC_FONT_SIZE_SCALE=1.0
NEXT_PUBLIC_KEYBOARD_NAVIGATION=true

# Development and Debug (set to false in production)
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_SHOW_PERFORMANCE_METRICS=false
NEXT_PUBLIC_ENABLE_REACT_DEVTOOLS=false

# CDN Configuration
NEXT_PUBLIC_CDN_URL=""
NEXT_PUBLIC_STATIC_ASSETS_URL=""

# Social/External Links
NEXT_PUBLIC_SUPPORT_EMAIL="support@giip.info"
NEXT_PUBLIC_DOCUMENTATION_URL="https://docs.giip.info"
NEXT_PUBLIC_STATUS_PAGE_URL="https://status.giip.info"

# Branding
NEXT_PUBLIC_LOGO_URL="/images/logo.png"
NEXT_PUBLIC_FAVICON_URL="/favicon.ico"
NEXT_PUBLIC_PRIMARY_COLOR="#3B82F6"
NEXT_PUBLIC_SECONDARY_COLOR="#10B981"